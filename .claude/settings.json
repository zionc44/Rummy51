{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/file-shape.js",
            "timeout": 10,
            "statusMessage": "Measuring the file"
          }
        ]
      }
    ]
  }
}
