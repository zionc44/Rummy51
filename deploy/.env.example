# Copied to .env beside compose.yml on the server and filled in there.
# .env is never committed.

# Letters and digits only, since it is written into a connection string
# where a ; or an = would end it early:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. Left empty, signing in through Google is switched off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
