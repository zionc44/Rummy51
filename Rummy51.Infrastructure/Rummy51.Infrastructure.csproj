<Project Sdk="Microsoft.NET.Sdk">

  <!-- Identity's SignInManager and Data Protection are ASP.NET Core libraries.
       The reference states a dependency this project already has; it does not
       make it a web project. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rummy51.Application\Rummy51.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Skia renders no text here, so the natives that need none are the
         ones to carry: a host needs no fontconfig for a picture to be
         decoded, resized and written back out. -->
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

  <!-- The tables are internal and are what this project is mostly made of,
       so the suite that holds them to the rules is let in. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Rummy51.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
