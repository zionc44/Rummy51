<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\rummy51.client</SpaRoot>
    <!-- The SPA proxy is intentionally NOT activated during development: the
         ASPNETCORE_HOSTINGSTARTUPASSEMBLIES entry was removed from
         Properties/launchSettings.json so that running the server does not also
         start Angular. Start the client manually with `npm start`.
         These two properties are kept so the launcher can be re-enabled by
         restoring that environment variable. -->
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:57541</SpaProxyServerUrl>
    <UserSecretsId>e85457e1-ee58-4d32-91ad-e04b01650102</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Builds the Angular app and copies it into wwwroot on publish. -->
  <ItemGroup>
    <ProjectReference Include="..\rummy51.client\rummy51.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Rummy51.Application\Rummy51.Application.csproj" />
    <ProjectReference Include="..\Rummy51.Infrastructure\Rummy51.Infrastructure.csproj" />
  </ItemGroup>

</Project>
